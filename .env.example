# --- Claude agent ---
# Option A: Anthropic API directly
ANTHROPIC_API_KEY=
# Option B: an Anthropic-compatible gateway (e.g. LiteLLM). Put the gateway key in
# ANTHROPIC_API_KEY, its URL here, and a model name the gateway serves.
ANTHROPIC_BASE_URL=
AGENT_MODEL=

# --- PayPal sandbox app (https://developer.paypal.com/dashboard/applications/sandbox) ---
# Leave blank to run in mock-payment mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the sandbox app webhook (URL: <origin>/api/paypal/webhook; events
# PAYMENT.CAPTURE.COMPLETED and CHECKOUT.ORDER.APPROVED). Webhook returns 503 while blank.
PAYPAL_WEBHOOK_ID=

# Optional: give the agent a small allowlist of real PayPal Agent Toolkit tools
# (list transactions, get order, create/send invoices; sandbox only, never moves money).
# Needs PAYPAL_CLIENT_ID/SECRET above. Set to 1 to enable.
PAYPAL_AGENT_TOOLKIT=
# Invoicer email on invoices the agent drafts. If blank, the agent doesn't offer invoices.
PAYPAL_INVOICER_EMAIL=

# Optional: a PayPal sandbox personal (buyer) account shown on pay pages so testers can
# log in at checkout. Sandbox only; never put a real PayPal login here.
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=

# Optional: send every payout to this sandbox personal account so you can see it land.
PAYPAL_PAYOUT_RECEIVER_OVERRIDE=

# --- Accounts and transactional emails ---
# Generate a secret with: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Exact public origin; use https://rotapot.simakk.co.za on the deployed server.
BETTER_AUTH_URL=http://localhost:3000
# Optional: enables "Continue with Google". Leave blank to hide the button.
# Authorized redirect URI in Google Cloud: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
# Sender must belong to a domain verified in your Resend account.
RESEND_FROM=
# Optional storage overrides. Both must live on a persistent, writable disk.
# AUTH_DB_PATH=/path/to/auth.sqlite
# ACCOUNT_DATA_DIR=/path/to/accounts
# Optional: only set when your reverse proxy overwrites this client-IP header.
# Without it, auth rate limits share a conservative per-endpoint bucket.
# AUTH_TRUSTED_IP_HEADER=x-real-ip

# --- Scheduled treasurer (POST /api/cron/briefing, called by a systemd timer) ---
# Shared secret the timer sends as "Authorization: Bearer ...". Unset = endpoint returns 503.
# Generate with: openssl rand -base64 32
CRON_SECRET=
# Most accounts one scheduled run will brief (default 25). Keeps LLM spend bounded.
CRON_MAX_ACCOUNTS=
# Skip an account whose last briefing is newer than this many hours (default 20).
# Comma-separated emails whose sample circles also get a scheduled run (e.g. the judge account).
CRON_SAMPLE_ACCOUNTS=
CRON_MIN_HOURS=
