# --- Claude agent ---
# Option A: Anthropic API directly
ANTHROPIC_API_KEY=
# Option B: an Anthropic-compatible gateway (e.g. LiteLLM). Put the gateway key in
# ANTHROPIC_API_KEY, its URL here, and a model name the gateway serves.
ANTHROPIC_BASE_URL=
AGENT_MODEL=

# --- PayPal sandbox app (https://developer.paypal.com/dashboard/applications/sandbox) ---
# Leave blank to run in mock-payment mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: send every payout to this sandbox personal account so you can see it land.
PAYPAL_PAYOUT_RECEIVER_OVERRIDE=
