# --- Claude agent ---
# Option A: Anthropic API directly
ANTHROPIC_API_KEY=
# Option B: an Anthropic-compatible gateway (e.g. LiteLLM). Put the gateway key in
# ANTHROPIC_API_KEY, its URL here, and a model name the gateway serves.
ANTHROPIC_BASE_URL=
AGENT_MODEL=

# --- PayPal sandbox app (https://developer.paypal.com/dashboard/applications/sandbox) ---
# Leave blank to run in mock-payment mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the sandbox app webhook (URL: <origin>/api/paypal/webhook; events
# PAYMENT.CAPTURE.COMPLETED and CHECKOUT.ORDER.APPROVED). Webhook returns 503 while blank.
PAYPAL_WEBHOOK_ID=

# Optional: send every payout to this sandbox personal account so you can see it land.
PAYPAL_PAYOUT_RECEIVER_OVERRIDE=

# --- Accounts and transactional emails ---
# Generate a secret with: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Exact public origin; use https://rotapot.simakk.co.za on the deployed server.
BETTER_AUTH_URL=http://localhost:3000
RESEND_API_KEY=
# Sender must belong to a domain verified in your Resend account.
RESEND_FROM=
# Optional storage overrides. Both must live on a persistent, writable disk.
# AUTH_DB_PATH=/path/to/auth.sqlite
# ACCOUNT_DATA_DIR=/path/to/accounts
# Optional: only set when your reverse proxy overwrites this client-IP header.
# Without it, auth rate limits share a conservative per-endpoint bucket.
# AUTH_TRUSTED_IP_HEADER=x-real-ip
